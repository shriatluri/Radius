# -----------------------------------------------------------------------
# Radius — environment variables
# Copy this file to .env and fill in values for your environment.
# -----------------------------------------------------------------------

# --- Database -----------------------------------------------------------
# PostgreSQL (production / Docker)
DATABASE_URL=postgresql://radius:radius@localhost:5432/radius
USE_DATABASE=true

# SQLite alternative (local dev without Docker)
# DATABASE_URL=sqlite:///./radius_dev.db

# --- Rate limiting ------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TOKENS=100          # max burst size
RATE_LIMIT_REFILL_RATE=1.67    # tokens per second (~100/min)

# --- Sanctions screening ------------------------------------------------
# SANCTIONS_PROVIDER options:
#   ofac_local     — OFAC SDN XML only (US-designated entities). Default.
#   opensanctions  — OFAC + EU + UN + 40 other lists via OpenSanctions API.
#                    Requires OPENSANCTIONS_API_KEY. Recommended for production.
#   none           — Disables screening (testing/sandbox only).
SANCTIONS_PROVIDER=ofac_local
OPENSANCTIONS_API_KEY=         # Get from opensanctions.org (free tier available)

# OFAC local settings (used by ofac_local provider and as fallback)
OFAC_SDN_URL=https://www.treasury.gov/ofac/downloads/sanctions/1.0/sdn_advanced.xml
OFAC_UPDATE_INTERVAL_HOURS=24
OFAC_DATA_DIR=/app/data/ofac   # container path; override for local dev

# --- Environment --------------------------------------------------------
# "development" — mock API keys (sk_test_*) accepted as fallback; dev key seeded on startup
# "production"  — mock keys disabled; only DB-backed keys work; no seeding
ENVIRONMENT=development

# --- Dev seed key -------------------------------------------------------
# Only used when ENVIRONMENT=development and the api_keys table is empty.
# If unset, a random key is generated at startup and printed to stdout once.
# Set this to keep a stable key across restarts (useful for local dev).
# DEV_API_KEY=sk_test_your_key_here

# --- Email (Resend) -----------------------------------------------------
# Get your API key from resend.com — free tier: 3,000 emails/month
# FROM_EMAIL must be a verified domain on Resend
RESEND_API_KEY=re_your_key_here
FROM_EMAIL=noreply@getradius.com

# --- CORS ---------------------------------------------------------------
# Comma-separated list of allowed origins for the frontend
# Dev default: http://localhost:5173
# Production example: https://app.yourcompany.com,https://dashboard.yourcompany.com
ALLOWED_ORIGINS=http://localhost:5173

# --- API ----------------------------------------------------------------
API_VERSION=0.2.0
