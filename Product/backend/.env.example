# Radius Backend — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite (default for local dev — no setup needed):
#   DATABASE_URL=sqlite:///./radius_dev.db
# PostgreSQL (recommended for staging/production):
#   DATABASE_URL=postgresql://radius:radius@localhost:5432/radius
DATABASE_URL=sqlite:///./radius_dev.db
USE_DATABASE=true

# ---------------------------------------------------------------------------
# Sanctions Screening
# ---------------------------------------------------------------------------
# Controls which sanctions provider is used for wallet screening.
#   ofac_local   — download and parse OFAC SDN XML locally (default)
#   none         — bypass all screening; for sandbox / test environments only
SANCTIONS_PROVIDER=ofac_local

# URL of the OFAC SDN Advanced XML file (contains crypto addresses).
# Only change if Treasury moves the file or you mirror it internally.
OFAC_SDN_URL=https://www.treasury.gov/ofac/downloads/sanctions/1.0/sdn_advanced.xml

# How often (in hours) to re-download and re-parse the SDN list.
OFAC_UPDATE_INTERVAL_HOURS=24

# Directory where the SDN XML, parsed address index, and metadata are cached.
# Defaults to backend/data/ofac/ relative to the backend directory.
# OFAC_DATA_DIR=/var/data/ofac

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TOKENS=100           # Max burst size (tokens in bucket)
RATE_LIMIT_REFILL_RATE=1.67     # Tokens added per second (~100/min)

# ---------------------------------------------------------------------------
# Clerk (dashboard auth)
# ---------------------------------------------------------------------------
# Clerk handles Google OAuth + email/password login for dashboard users.
# Get keys from https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_VERSION=0.2.0
